<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ILSpyMobile.MainPage"
             Title="ILSpy Mobile">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="10">

        <!-- Título -->
        <Label Text="ILSpy Mobile"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Grid.Row="0" />

        <!-- Botão de seleção -->
        <Button x:Name="BtnPick"
                Text="Selecionar DLL / EXE"
                Clicked="OnPickClicked"
                BackgroundColor="#512BD4"
                TextColor="White"
                Grid.Row="1" />

        <!-- Área do código descompilado -->
        <ScrollView Grid.Row="2">
            <Editor x:Name="CodeEditor"
                    IsReadOnly="True"
                    FontFamily="Courier New"
                    FontSize="12"
                    AutoSize="TextChanges"
                    Placeholder="O código C# descompilado aparecerá aqui..." />
        </ScrollView>

        <!-- Status -->
        <Label x:Name="StatusLabel"
               Text="Pronto"
               FontSize="12"
               TextColor="Gray"
               Grid.Row="3" />

    </Grid>
</ContentPage>
